{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main and popup windows",
  "windows": ["main", "popup-dict", "popup-translate"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
